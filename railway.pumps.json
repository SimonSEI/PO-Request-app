{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/pumps.py",
      "/pumps_page.py",
      "/pump_reports.py",
      "/pumps_server.py",
      "/pumps_link.py",
      "/shared_mail.py",
      "/pumps_assets/**",
      "/requirements.txt",
      "/runtime.txt",
      "/nixpacks.toml",
      "/railway.pumps.json"
    ]
  },
  "deploy": {
    "startCommand": "gunicorn --workers=2 --threads=4 --timeout=60 --bind=0.0.0.0:$PORT pumps_server:app",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
