# Copy this to .env and fill in your values
# Or set these as environment variables in Railway

SECRET_KEY=your-strong-random-secret-key-here
SMTP_EMAIL_ADDRESS=your-notification-email@gmail.com
SMTP_EMAIL_PASSWORD=your-app-password
NOTIFICATION_EMAIL=recipient@example.com
CHRISTIAN_EMAIL=christian@example.com
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
WEBSITE_URL=https://your-app.railway.app
PORT=5000

# PO Email Monitoring Configuration (for automatic invoice processing)
# This enables automatic invoice matching from incoming emails
PO_EMAIL_ADDRESS=PO@stahlman-england.com
PO_EMAIL_PASSWORD=your-outlook-password
PO_EMAIL_PROVIDER=outlook

# Email Provider Options: 'outlook' (default) or 'gmail'
# Outlook IMAP: imap-mail.outlook.com:993
# Gmail IMAP: imap.gmail.com:993 (requires App Password)

# Pumps app (pump/diver/filter/SCADA work from request to invoice; see PUMPS_README.md)
# Its own Jobber app (developer.getjobber.com): read Clients, Requests, Jobs;
# WRITE Quotes, Invoices and Notes (drafts only). Callback URL: <WEBSITE_URL>/pumps/jobber/callback
PUMPS_JOBBER_CLIENT_ID=
PUMPS_JOBBER_CLIENT_SECRET=
# Optional:
# PUMPS_JOBBER_CALLBACK_URL=https://your-app.railway.app/pumps/jobber/callback
# PUMPS_USERS=simon,beatriz          # only these usernames (default: every office login)
# PUMPS_MARKUP_PCT=0                 # added to the sub's prices on drafted invoices
# PUMPS_SCAN_SINCE=2026-08-01        # first mailbox scan starts here (default: 60 days back)
# PUMPS_SCAN_EVERY_MINUTES=30
# PUMPS_AUTO_SCAN=true
# PUMPS_COMPANY_PHONE= / PUMPS_COMPANY_EMAIL=   # put in place of the sub's on rebranded reports
# PUMPS_WEBHOOK_URL=                 # POSTed when an issue is raised (e.g. bill over quote)
# ANTHROPIC_API_KEY reads quotes and bills; without it a basic reader is used and every
# document is marked for review.
# Older single Jobber token, used by Pumps only if no Jobber app is connected
JOBBER_API_TOKEN=your-jobber-api-token
# Shared secret OpenClaw sends as "Authorization: Bearer <key>" to /api/pumps/... and
# /api/openclaw/pumps. Unset = those APIs are off.
# Also used by the Work Orders app to authenticate OpenClaw quote drafting.
OPENCLAW_API_KEY=your-openclaw-shared-secret

# Work Orders App (Features Coming Soon)
# When a technician flags a work order as "Needs Quote", the app can ping OpenClaw
# to draft a quote for the client. This pipeline is fully wired but OFF by default
# ("ready to turn on"). Set WORKORDERS_OPENCLAW_QUOTES=true to activate it.
WORKORDERS_OPENCLAW_QUOTES=false
# Endpoint OpenClaw exposes for drafting quotes (used only when the feature is on).
OPENCLAW_QUOTE_URL=https://api.openclaw.ai/v1/quotes/draft

# Cash Flow & AR app
# Jobber OAuth app for this service (create one at developer.getjobber.com with
# read access to Clients, Invoices, Jobs and Payments). Its OAuth Callback URL is
# shown on Cash Flow > Setup: <WEBSITE_URL>/cashflow/jobber/callback
JOBBER_CLIENT_ID=your-jobber-app-client-id
JOBBER_CLIENT_SECRET=your-jobber-app-client-secret
# Optional: override the callback URL or the Jobber API version
# JOBBER_CALLBACK_URL=https://your-app.railway.app/cashflow/jobber/callback
# JOBBER_API_VERSION=2025-04-16
# Cash Flow & AR is for office logins only (admins, techs and property
# managers never see it). Optional: narrow it to these office usernames.
# Unset = every office login.
# CASHFLOW_USERS=simon,christian

# QuickBooks Online for Cash Flow & AR (developer.intuit.com app, Accounting
# scope, production keys). Redirect URI: <WEBSITE_URL>/cashflow/qbo/callback
# Terms/privacy page for Intuit's form: <WEBSITE_URL>/cashflow/legal
QBO_CLIENT_ID=your-intuit-client-id
QBO_CLIENT_SECRET=your-intuit-client-secret
# QBO_ENVIRONMENT=sandbox   # only while testing with Intuit's sandbox company
# Cash Flow & AR is OFF unless this is set. While off, /cashflow returns 404,
# nothing syncs, and any stored Jobber/QuickBooks sign-in is wiped at startup.
# CASHFLOW_ENABLED=true
# Required to switch Cash Flow on: encrypts the stored Jobber/QuickBooks
# sign-ins and authenticator secrets. Any random text, 32+ characters, kept
# only in Railway. Example to generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# CASHFLOW_TOKEN_KEY=

# Time-Off Log app (technician time off and sick call-outs; see TIMEOFF_README.md)
# OpenClaw calls /api/time-off with "Authorization: Bearer <token>". Unset = API off.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TIMEOFF_API_TOKEN=
# Where the app POSTs a request after Beatriz approves/denies it in the app.
OPENCLAW_WEBHOOK_URL=
# Optional: sent to OpenClaw as a bearer token, and used to sign the webhook body.
# OPENCLAW_WEBHOOK_SECRET=
# Optional: only these usernames can open Time-Off (technicians never can).
# Unset = every office login.
# TIMEOFF_USERS=simon,beatriz
