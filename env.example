# Copy this to .env and fill in your values
# Or set these as environment variables in Railway

SECRET_KEY=your-strong-random-secret-key-here
SMTP_EMAIL_ADDRESS=your-notification-email@gmail.com
SMTP_EMAIL_PASSWORD=your-app-password
NOTIFICATION_EMAIL=recipient@example.com
CHRISTIAN_EMAIL=christian@example.com
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
WEBSITE_URL=https://your-app.railway.app
PORT=5000

# PO Email Monitoring Configuration (for automatic invoice processing)
# This enables automatic invoice matching from incoming emails
PO_EMAIL_ADDRESS=PO@stahlman-england.com
PO_EMAIL_PASSWORD=your-outlook-password
PO_EMAIL_PROVIDER=outlook

# Email Provider Options: 'outlook' (default) or 'gmail'
# Outlook IMAP: imap-mail.outlook.com:993
# Gmail IMAP: imap.gmail.com:993 (requires App Password)

# Pumps App (Features Coming Soon)
# JOBBER_API_TOKEN lets the invoice agent draft invoices in Jobber
JOBBER_API_TOKEN=your-jobber-api-token
# Shared secret for the OpenClaw autonomous-intake webhook (POST /api/openclaw/pumps
# with header "Authorization: Bearer <key>"). Leave unset to disable the webhook.
OPENCLAW_API_KEY=your-openclaw-shared-secret
