+# ── 2. Jobber: the open work order list on the work order job's next visit ────
+#
+# The office keeps the open work orders as the Instructions of the next visit on
+# the community's "WORK ORDER" job, one per line:
+#     20770-121623     7795 Ionio Court
+# Regino works from that list and adds his notes in the Jobber app. Each cycle the
+# app reads his notes, closes what he finished, and rewrites the list on the next
+# visit that is not complete yet: whatever is still open plus anything new.
+
+WO_LINE = re.compile(r'^\s*(\d{3,7}-\d{3,9})\b[ \t]*(.*)$')
+_SCHEMA_CACHE = {}
+_TYPE_REF = 'kind name ofType { kind name ofType { kind name } }'
+
+
+def _gql_type(name):
+    if name not in _SCHEMA_CACHE:
+        q = ('query($n: String!) { __type(name: $n) { name '
+             'fields { name args { name type { %s } } type { %s } } inputFields { name } } }' % (_TYPE_REF, _TYPE_REF))
+        _SCHEMA_CACHE[name] = _jobber(q, {'n': name}).get('__type') or {}
+    return _SCHEMA_CACHE[name]
+
+
+def _base_type(t):
+    while t and t.get('ofType'):
+        t = t['ofType']
+    return (t or {}).get('name') or ''
+
+
+def _type_sig(t):
+    """GraphQL type text for a variable, e.g. EncodedId! or VisitEditInput!"""
+    if not t:
+        return ''
+    if t.get('kind') == 'NON_NULL':
+        return _type_sig(t.get('ofType')) + '!'
+    if t.get('kind') == 'LIST':
+        return '[' + _type_sig(t.get('ofType')) + ']'
+    return t.get('name') or ''
+
+
+def _visit_edit():
+    """The Jobber mutation that edits a visit's instructions, found by asking Jobber's own schema.
+    Returns {name, id_arg, id_type, input_arg, input_type, has_errors}, or raises when there is none."""
+    if 'visit_edit' in _SCHEMA_CACHE:
+        return _SCHEMA_CACHE['visit_edit']
+    found = None
+    for f in _gql_type('Mutation').get('fields') or []:
+        if not ALLOWED_MUTATION_PATTERN.match(f['name']):
+            continue
+        id_arg = next((a for a in f['args'] if _base_type(a['type']) in ('EncodedId', 'ID')), None)
+        if not id_arg:
+            continue
+        for a in f['args']:
+            t = _base_type(a['type'])
+            if a is id_arg or not t:
+                continue
+            if 'instructions' in {x['name'] for x in (_gql_type(t).get('inputFields') or [])}:
+                payload = {x['name'] for x in (_gql_type(_base_type(f['type'])).get('fields') or [])}
+                found = {'name': f['name'], 'id_arg': id_arg['name'], 'id_type': _type_sig(id_arg['type']),
+                         'input_arg': a['name'], 'input_type': _type_sig(a['type']),
+                         'has_errors': 'userErrors' in payload}
+                break
+        if found:
+            break
+    if not found:
+        raise RuntimeError("Jobber's API does not let this app change a visit's instructions")
+    _SCHEMA_CACHE['visit_edit'] = found
+    return found
+
+
+def _job_visits(job_id):
+    """Visits on the job, oldest first, as {id, title, instructions, start, done, completed_at}."""
+    have = {f['name'] for f in (_gql_type('Visit').get('fields') or [])}
+    want = [f for f in ('id', 'title', 'instructions', 'startAt', 'completedAt', 'isComplete', 'visitStatus') if f in have]
+    if 'id' not in want:
+        want.insert(0, 'id')
+    out, after = [], None
+    for _ in range(5):
+        q = ('query($id: EncodedId!, $after: String) { job(id: $id) { visits(first: 50, after: $after) { '
+             'nodes { %s } pageInfo { hasNextPage endCursor } } } }' % ' '.join(want))
+        page = ((_jobber(q, {'id': job_id, 'after': after}).get('job') or {}).get('visits')) or {}
+        for v in page.get('nodes') or []:
+            done = bool(v.get('completedAt') or v.get('isComplete') or
+                        str(v.get('visitStatus') or '').upper() in ('COMPLETED', 'COMPLETE'))
+            out.append({'id': v['id'], 'title': v.get('title') or '', 'instructions': v.get('instructions') or '',
+                        'start': v.get('startAt') or '', 'done': done, 'completed_at': v.get('completedAt') or ''})
+        info = page.get('pageInfo') or {}
+        if not info.get('hasNextPage'):
+            break
+        after = info.get('endCursor')
+    return sorted(out, key=lambda v: v['start'])
+
+
+def _visit_list(orders, keep=''):
+    """The instructions text: lines that are not work orders stay on top, then one line per open work order."""
+    other = [ln for ln in (keep or '').splitlines() if ln.strip() and not WO_LINE.match(ln)]
+    lines = [f"{o['wo_number'] or '(no #)'}     {o['address']}".rstrip() for o in orders]
+    return '\n'.join(other + lines)
+
+
+def _same_list(a, b):
+    def norm(t):
+        return [re.sub(r'\s+', ' ', ln).strip().lower() for ln in (t or '').splitlines() if ln.strip()]
+    return norm(a) == norm(b)
+
+
+def _set_visit_instructions(visit_id, text):
+    m = _visit_edit()
