+        return '\n'.join(extra)
+    mine = {re.sub(r'\s+', ' ', ln).strip().lower() for ln in ours.splitlines()}
+    return '\n'.join(ln for ln in v['instructions'].splitlines()
+                     if ln.strip() and re.sub(r'\s+', ' ', ln).strip().lower() not in mine)
