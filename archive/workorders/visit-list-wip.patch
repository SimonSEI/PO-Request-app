+         f"{m['input_arg']}: $input) {{ {result} }} }}")
+    data = _jobber(q, {'id': visit_id, 'input': {'instructions': text}})
+    errs = ((data.get(m['name']) or {}).get('userErrors')) or []
     if errs:
