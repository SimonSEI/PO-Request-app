# Build context exclusions.
# .Rlib is the project package library - hundreds of MB, and irrelevant to the
# container, which installs its own Linux binaries from the base image.
.Rlib/
.Rproj.user/
.git/
.gitignore

# Raw downloads: a 1.55GB Access database, 168MB of parcel records, cached PDFs.
# These feed the analysis scripts, not the running dashboard.
data/raw/

# R/ is NOT excluded: the private clients service (clients/Dockerfile) copies
# the Jobber scripts from it. The public dashboard's Dockerfile copies only
# named files, so the pipeline scripts still never enter that image.
#
# output/ is excluded, EXCEPT the two files the running app actually reads.
# Order matters here: the exclusion must come before the negations.
output/*
!output/season_forecast.csv
!output/seasonal_curve.csv
*.Rproj
README.md
run_watcher.bat
setup_project_library.R
run_app.R

# Client data (also git-ignored) - must never be baked into the public image.
.Renviron
data/jobber/
