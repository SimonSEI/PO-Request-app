{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": ["/**", "!/snowbirds/**"]
  },
  "deploy": {
    "startCommand": "gunicorn --workers=2 --threads=4 --timeout=60 --bind=0.0.0.0:$PORT app:app",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
 
